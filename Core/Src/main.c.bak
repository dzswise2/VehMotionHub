const uint8_t Days[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
const uint16_t monDays[12] = {0,31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};

uint32_t time2Stamp(RTC_DateTypeDef date, RTC_TimeTypeDef time)    //beijing time to stamp
{
	double result;
	uint16_t Year=date.Year+2000;
	result = (Year - 1970) * 365 * 24 * 3600 + (monDays[date.Month-1] + date.Date - 1) * 24 * 3600 + (time.Hours-8) * 3600 + time.Minutes * 60 + time.Seconds;
	//printf("[%u]",result);
	result += (date.Month>2 && (Year % 4 == 0) && (Year % 100 != 0 || Year % 400 == 0))*24*3600;	//run month
	//printf("[%u]",result);
	Year -= 1969;
	result += (Year/4 - Year/100 + Year/400)*24 * 3600;		//leap year

	//result=result+0.01;
	return result;

}
