void work_state(void const *argument) {
    for(;;){
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
        osDelay(500);
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
        osDelay(500);
    }
}

/*
GearLvrIndcn        - 挡位信息

SteerWhlAgSafe   - 方向盘转�?

VehSpdLgtSafe     - 车�??

WhlSpdCircumlFrntLe  - 左前轮轮�?

WhlSpdCircumlFrntWhlSpdCircumlFrntRi   - 右前轮轮�?

WhlSpdCircumlReLe   - 左后轮轮�?

WhlSpdCircumlReRi    - 右后轮轮�?

YawRate1     - 偏航�?
 */

void can_com(void const *argument) {
    for(;;){
    	    {

    	    	if(NOtification_flag ==1)
    	    		  	{
    	    		  		HAL_FDCAN_GetRxMessage(&hfdcan1,FDCAN_RX_FIFO0,&RxHeader,RxData);
    	    		  		//printf("canid=%lx",RxHeader.Identifier);
    	    				//printf("speed data=%x\r\n",RxData[5]);
    	    		  		//read can_data
    	    		  		NOtification_flag=0;
    	    		  									if (RxHeader.Identifier==0xE0)
    	    		  		    	    		  		{
    	    		  		    	    		  			//printf("speed data=%x\r\n",RxData[5]);
    	    		  		    	    		  			//char s1[2] = (char)RxData[5];
    	    		  		    	    		  			s1=(int*)RxData[5];
    	    		  		    	    		  			//printf("speed data=%.3f\r\n",whl_data.vhespeed);
    	    		  		    	    		  			whl_data.vhespeed=s1*0.00391;
    	    		  		    	    		  			//printf("speed data=%.3f\r\n",whl_data.vhespeed);
    	    		  		    	    		  			can_n=can_n+1;
    	    		  		    	    		  		}
    	    		  		    	    		  		//read can_data
    	    		  		    	    		  		if (RxHeader.Identifier==0x1A0)
    	    		  		    	    		  		{
    	    		  		    	    		  			//printf("WhlSpdCircumlFrntLe=%x\r\n",RxData[1]);
    	    		  		    	    		  			//printf("WhlSpdCircumlFrntWhlSpdCircumlFrntRi=%x\r\n",RxData[5]);
    	    		  		    	    		  			s1=(int*)RxData[1];
    	    		  		    	    		  			s2=(int*)RxData[5];
    	    		  		    	    		  			whl_data.whlft=s1*0.00391;
    	    		  		    	    		  			whl_data.whlrt=s2*0.00391;
    	    		  		    	    		  			//printf("WhlSpdCircumlFrntLe=%.3f WhlSpdCircumlFrntWhlSpdCircumlFrntRi=%.3f\r\n",whl_data.whlft,whl_data.whlrt);
    	    		  		    	    		  			can_n=can_n+1;

    	    		  		    	    		  		}
    	    		  		    	    		  		if (RxHeader.Identifier==0x1C0)
    	    		  		    	    		  		{
    	    		  		    	    		  			//printf("WhlSpdCircumlReLe=%x\r\n",RxData[3]);
    	    		  		    	    		  			//printf("WhlSpdCircumlReRi=%x\r\n",RxData[7]);
    	    		  		    	    		  			s1=(int*)RxData[3];
    	    		  		    	    		  			s2=(int*)RxData[7];
    	    		  		    	    		  			whl_data.whlfb=s1*0.00391;
    	    		  		    	    		  			whl_data.whlrb=s2*0.00391;
    	    		  		    	    		  			//printf("WhlSpdCircumlReLe=%.3f WhlSpdCircumlReRi=%.3f\r\n",whl_data.whlfb,whl_data.whlrb);
    	    		  		    	    		  			can_n=can_n+1;
    	    		  		    	    		  		}
    	    		  		    	    		  		if (RxHeader.Identifier==0x40)
    	    		  		    	    		  		{

    	    		  		    	    		  			//printf("SteerWhlAgSafe=%x\r\n",RxData[1]);
    	    		  		    	    		  			s1=(int*)RxData[1];
    	    		  		    	    		  			whl_data.gear=s1*1.0;
    	    		  		    	    		  			can_n=can_n+1;
    	    		  		    	    		  		}


    	    		  		HAL_FDCAN_ActivateNotification(&hfdcan1, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0);



    	    		  	}
    	    	//GRODO，时间，左前，右前，左后，右后，航向角，档位�?...(其他信息)*校验�?
    	    	if(can_n>=4)
    	    	{
    	    		char can_data[130] ="$GRODO,";
    	    		sprintf(can_buf0, "%.3f", time_ms);
    	    	    sprintf(can_buf1, "%.3f", whl_data.whlft);
    	    	    sprintf(can_buf2, "%.3f", whl_data.whlrt);
    	    	    sprintf(can_buf3, "%.3f", whl_data.whlfb);
    	    	    sprintf(can_buf4, "%.3f", whl_data.whlrb);
    	    	    sprintf(can_buf5, "%.3f", whl_data.vhespeed);
    	    	    sprintf(can_buf6, "%.3f", whl_data.gear);


    	    	    strcat(can_data,can_buf0);
    	    	    strcat(can_data,",");
    	    	    strcat(can_data,can_buf1);
    	    	    strcat(can_data,",");
    	    	    strcat(can_data,can_buf2);
    	    	    strcat(can_data,",");
    	    	    strcat(can_data,can_buf3);
    	    	    strcat(can_data,",");
    	    	    strcat(can_data,can_buf4);
    	    	    strcat(can_data,",");
    	    	    strcat(can_data,can_buf5);
    	    	    strcat(can_data,",");
    	    	    strcat(can_data,can_buf6);
    	    	    strcat(can_data,"*");

    	    	    re=CheckXOR(can_data);

    	    		printf("%s%x\r\n",can_data,re);
    	    		can_n=0;
    	    	}

    	    }
    }
}




