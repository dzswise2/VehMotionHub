uint8_t CheckXOR(char* pbuff)
{
  unsigned char tmp = 0;
  int i = 1;
  if (pbuff[0] != '$')
  {
    return 0;
  }
  while (1)
  {
    tmp = pbuff[i] ^ tmp;
    i++;
    if (pbuff[i] == '*')
    {
      return tmp;
    }
  }
}


